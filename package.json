{
  "name": "nexus",
  "displayName": "Nexus",
  "description": "Private remote bridge for coding agents",
  "version": "1.3.0",
  "publisher": "nabster",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/nlabrazi/nexus.git"
  },
  "main": "./dist/daemon.js",
  "bin": {
    "nexus-daemon": "./dist/daemon.js"
  },
  "scripts": {
    "daemon": "node dist/daemon.js",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run generate",
    "android:sync": "npm --prefix web run cap:sync",
    "android:build": "node scripts/build-android.cjs",
    "android:release": "node scripts/build-android.cjs --bump patch",
    "android:open": "npm --prefix web run cap:open",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\" && tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "lint:fix:unsafe": "biome check --write --unsafe src",
    "format": "biome format --write src",
    "test": "npm run test:unit",
    "test:unit": "npm run compile-tests && node --test --test-isolation=none out/test/unit/*.unit.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "24.x",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
