{
  "name": "nexus",
  "displayName": "Nexus",
  "description": "Private remote bridge for vscode coding agents",
  "version": "0.3.1",
  "publisher": "nabster",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/nlabrazi/nexus.git"
  },
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Nexus",
      "properties": {
        "nexus.git.protectedBranches": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": ["main", "master"],
          "scope": "window",
          "description": "Branches sur lesquelles Nexus refuse de lancer Codex ou Antigravity. Noms exacts, sensibles à la casse. Une liste vide désactive cette protection."
        },
        "nexus.defaultBackend": {
          "type": "string",
          "enum": ["codex", "antigravity"],
          "default": "codex",
          "scope": "window",
          "description": "Backend agent par défaut pour les commandes Telegram (/new, /resume, /model)."
        },
        "nexus.speech.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Chemin absolu vers le Python de l'environnement local contenant faster-whisper. À configurer sur la machine où Nexus s'exécute (WSL/SSH le cas échéant)."
        },
        "nexus.speech.modelPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Chemin absolu vers le modèle faster-whisper déjà téléchargé. La transcription ne télécharge rien."
        },
        "nexus.speech.language": {
          "type": "string",
          "default": "",
          "pattern": "^$|^[a-z]{2,3}$",
          "scope": "machine",
          "description": "Langue des audios, par exemple fr ou en. Vide : détection automatique."
        },
        "nexus.antigravity.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Chemin explicite vers l'exécutable de Gemini Antigravity (agy). Laisser vide pour utiliser agy depuis le PATH."
        },
        "nexus.antigravity.sandbox": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Active le mode sandbox pour Gemini Antigravity (--sandbox)."
        },
        "nexus.antigravity.dangerouslySkipPermissions": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Autorise Antigravity à exécuter sans invite d'approbation (--dangerously-skip-permissions). Déconseillé."
        }
      }
    },
    "commands": [
      {
        "command": "nexus.testSpeechToText",
        "title": "Nexus: Test Local Speech-to-Text"
      },
      {
        "command": "nexus.switchBranch",
        "title": "Nexus: Switch Branch"
      },
      {
        "command": "nexus.status",
        "title": "Nexus: Status"
      },
      {
        "command": "nexus.selectBackend",
        "title": "Nexus: Select Active Backend"
      },
      {
        "command": "nexus.configureTelegram",
        "title": "Nexus: Configure Telegram"
      },
      {
        "command": "nexus.testTelegram",
        "title": "Nexus: Test Telegram Connection"
      },
      {
        "command": "nexus.pairTelegram",
        "title": "Nexus: Pair Telegram"
      },
      {
        "command": "nexus.testCodex",
        "title": "Nexus: Test Codex Connection"
      },
      {
        "command": "nexus.startCodexSession",
        "title": "Nexus: Start Codex Session"
      },
      {
        "command": "nexus.newCodexSession",
        "title": "Nexus: New Codex Session"
      },
      {
        "command": "nexus.resumeCodexSession",
        "title": "Nexus: Resume Codex Session"
      },
      {
        "command": "nexus.testCodexPrompt",
        "title": "Nexus: Test Codex Prompt"
      },
      {
        "command": "nexus.testAntigravity",
        "title": "Nexus: Test Antigravity Connection"
      },
      {
        "command": "nexus.startAntigravitySession",
        "title": "Nexus: Start Antigravity Session"
      },
      {
        "command": "nexus.newAntigravitySession",
        "title": "Nexus: New Antigravity Session"
      },
      {
        "command": "nexus.resumeAntigravitySession",
        "title": "Nexus: Resume Antigravity Session"
      },
      {
        "command": "nexus.testAntigravityPrompt",
        "title": "Nexus: Test Antigravity Prompt"
      }
    ]
  },
  "scripts": {
    "dev:prepare": "npm run compile && node scripts/prepare-dev.cjs",
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "lint:fix:unsafe": "biome check --write --unsafe src",
    "format": "biome format --write src",
    "test": "vscode-test",
    "test:unit": "npm run compile-tests && node --test --test-isolation=none out/test/unit/*.unit.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.137.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
