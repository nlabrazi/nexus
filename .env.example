# ==============================================================================
# Nexus Core Configuration Environment Variables
# ==============================================================================

# Port on which Nexus Core listens (default: 4040)
NEXUS_CORE_PORT=4040

# Bind host (use 0.0.0.0 in Docker containers, 127.0.0.1 for local host only)
NEXUS_CORE_HOST=0.0.0.0

# Comma-separated list of authorized authentication tokens for Desktop Nodes and clients
NEXUS_CORE_AUTH_TOKENS=change-me-to-a-secure-random-token

# Runtime logs: default ~/.nexus/logs/{core,desktop}; no secrets or conversations.
# NEXUS_LOG_DIR=/absolute/path/to/logs
NEXUS_LOG_LEVEL=info
