# ==============================================================================
# Nexus Core Configuration Environment Variables
# ==============================================================================

# Port on which Nexus Core listens (default: 4040)
NEXUS_CORE_PORT=4040

# Bind host (use 0.0.0.0 in Docker containers, 127.0.0.1 for local host only)
NEXUS_CORE_HOST=0.0.0.0

# Comma-separated list of authorized authentication tokens for Desktop Nodes and clients
NEXUS_CORE_AUTH_TOKENS=change-me-to-a-secure-random-token

# Runtime logs: default ~/.nexus/logs/{core,desktop}; no secrets or conversations.
# NEXUS_LOG_DIR=/absolute/path/to/logs
NEXUS_LOG_LEVEL=info

# Nexus Brain: configure on the machine running nexus-desktop or the VS Code extension.
# Core only forwards requests; these keys must never be put in the Android/web client.
# auto: configured clouds in order, then Ollama. ollama: local only.
# Other pinned backends: cerebras, groq, gemini, openrouter; legacy codex is supported.
NEXUS_BRAIN_BACKEND=auto
NEXUS_BRAIN_MODEL=qwen3.6:27b-mtp-q4_K_M
OLLAMA_HOST=http://127.0.0.1:11434

# Leave missing keys blank; those providers are skipped in auto mode.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# GOOGLE_GENAI_API_KEY is also accepted when GEMINI_API_KEY is absent.
OPENROUTER_API_KEY=
# Only openrouter/free or a model ending in :free is accepted.
OPENROUTER_MODEL=openrouter/free
